snapshot_timestamp=1748247150
pkg=libxml2
# version_orig=2.7.1
# version="$version_orig-1"
version_suffix="gl0+bp1592"
BASE_URL=https://packages.gardenlinux.io

apt-get install --no-install-recommends -y curl gzip ca-certificates
curl -sSL ${BASE_URL}/debian-snapshot/dists/${snapshot_timestamp}/main/source/Sources.gz | gunzip >Sources

DIRECTORY=$(grep -A100 "Package: $pkg" Sources | grep Directory | head -1 | cut -d' ' -f2)
# reverse sort so that "orig" comes first
FILES=$(grep -A100 "Package: $pkg" Sources | grep Files: -A100 | grep " ${pkg}_" | grep -E '\.(orig|debian)\.' | cut -d' ' -f4 | sort -ur)

mkdir -p "$dir/src"

for file in ${FILES}; do
  if echo ${file} | grep '\.orig\.'; then
    # TODO: check compression format
    curl -L "${BASE_URL}/${DIRECTORY}/${file}" | xz -d | tee "$dir/orig.tar" | tar xf - --strip-components 1 --directory "$dir/src"
  elif echo ${file} | grep '\.debian\.'; then
    curl -L "${BASE_URL}/${DIRECTORY}/${file}" | xz -d | tee "$dir/debian.tar" | tar xf - --directory "$dir/src"
  fi
done

